  <div class="top-actions">
    <button class="icon-btn" id="themeBtn" title="Switch theme"></button>
    <a class="btn hide-mobile" href="#/upload" id="uploadBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 16V4m0 0l-4 4m4-4l4 4"/><path d="M4 20h16"/></svg>
      Create
    </a>
    <div style="position:relative" id="userMenuWrap"></div>
  </div>
</header>

<div id="shell">
  <nav id="sidebar"></nav>
  <main id="main"><div class="empty">Loading…</div></main>
</div>

<nav id="bottomnav"><div class="bwrap" id="bnav"></div></nav>
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script>
/* ================= CONFIG ================= */
const SUPABASE_URL  = "PASTE_YOUR_SUPABASE_URL";
const SUPABASE_ANON_KEY = "PASTE_YOUR_SUPABASE_ANON_KEY";

const CONFIGURED = !SUPABASE_URL.includes("PASTE_") && !SUPABASE_ANON_KEY.includes("PASTE_");

/* ================= STATE / INIT ================= */
let sb = null;
let me = null;         // auth user
let myProfile = null; // my profile row
const profileCache = {};

if (!CONFIGURED) {
  document.getElementById('main').innerHTML = `
    <div class="setup-screen">
      <div style="font-size:52px;margin-bottom:10px">🛠️</div>
      <h1>Almost there!</h1>
      <p>KarmaWorkspace is deployed, but it isn't connected to its database yet.<br><br>
      The site owner needs to paste the <b>Supabase project URL</b> and <b>anon key</b> into the site configuration and redeploy. Refresh once that's done.</p>
    </div>`;
} else {
  sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  boot();
}

async function boot(){
  applyTheme();
  renderThemeBtn();
  bindSearch();
  const { data:{ user } } = await sb.auth.getUser();
  me = user;
  if (me) await loadMyProfile();
  renderSidebar(); renderUserMenu(); renderBottomNav();
  sb.auth.onAuthStateChange(async (evt, session)=>{
    me = session?.user ?? null;
    if (me) await loadMyProfile(); else myProfile = null;
    renderSidebar(); renderUserMenu(); renderBottomNav(); route();
  });
  window.addEventListener('hashchange', route);
  route();
}

async function loadMyProfile(){
  const { data } = await sb.from('profiles').select('*').eq('id', me.id).maybeSingle();
  myProfile = data;
}

/* ================= HELPERS ================= */
const $ = s => document.querySelector(s);
const main = () => document.getElementById('main');
function esc(s){ return String(s??'').replace(/[&<>"']/g, c => '&#' + c.charCodeAt(0) + ';'); }
function timeAgo(iso){
  const s = Math.floor((Date.now() - new Date(iso).getTime())/1000);
  if (s < 60) return 'just now';
  const m = Math.floor(s/60); if (m < 60) return m + 'm ago';
  const h = Math.floor(m/60); if (h < 24) return h + 'h ago';
  const d = Math.floor(h/24); if (d < 30) return d + 'd ago';
  const mo = Math.floor(d/30); if (mo < 12) return mo + 'mo ago';
  return Math.floor(mo/12) + 'y ago';
}
function fmtNum(n){ n = n||0; if (n >= 1e6) return (n/1e6).toFixed(1).replace('.0','') + 'M'; if (n >= 1e3) return (n/1e3).toFixed(1).replace('.0','') + 'K'; return String(n); }
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(t._h); t._h = setTimeout(()=>t.classList.remove('show'), 2400);
}
const ICONS = {
  heart:'<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7.5-4.7-10-9.3C.6 8.6 2.6 5 6.2 5c2 0 3.4 1.1 4.2 2.4L12 9l1.6-1.6C14.4 6.1 15.8 5 17.8 5c3.6 0 5.6 3.6 4.2 6.7C19.5 16.3 12 21 12 21z"/></svg>',
  heartO:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7.5-4.7-10-9.3C.6 8.6 2.6 5 6.2 5c2 0 3.4 1.1 4.2 2.4L12 9l1.6-1.6C14.4 6.1 15.8 5 17.8 5c3.6 0 5.6 3.6 4.2 6.7C19.5 16.3 12 21 12 21z"/></svg>',
  comment:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  share:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>',
  video:'<svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 16.5l6-4.5-6-4.5z"/><path d="M4 4h16v16H4z" fill="none" stroke="currentColor" stroke-width="2"/></svg>',
  image:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>',
  note:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg>',
};
function avatarHTML(p, size){
  const s = size || 36, fs = Math.round(s*0.4);
  if (p?.avatar_url) return `<img class="avatar" src="${esc(p.avatar_url)}" width="${s}" height="${s}" alt="" style="width:${s}px;height:${s}px">`;
  const letter = esc((p?.name || '?').trim().charAt(0).toUpperCase());
  return `<div class="avatar" style="width:${s}px;height:${s}px;font-size:${fs}px">${letter}</div>`;
}
async function getProfile(id){
  if (profileCache[id]) return profileCache[id];
  const { data } = await sb.from('profiles').select('id,handle,name,avatar_url').eq('id', id).maybeSingle();
  profileCache[id] = data || { id, name:'Unknown', handle:'unknown' };
  return profileCache[id];
}

/* ================= THEME ================= */
function applyTheme(){
  const pref = localStorage.getItem('kw-theme'); // 'light' | 'dark' | null(follow device)
  if (pref) document.documentElement.setAttribute('data-theme', pref);
  else document.documentElement.removeAttribute('data-theme');
}
function renderThemeBtn(){
  const btn = $('#themeBtn');
  const current = document.documentElement.getAttribute('data-theme') ||
    (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  btn.innerHTML = current === 'light'
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="19" height="19"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>'
    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="19" height="19"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';
}
$('#themeBtn').addEventListener('click', ()=>{
  const current = document.documentElement.getAttribute('data-theme') ||
    (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  localStorage.setItem('kw-theme', current === 'light' ? 'dark' : 'light');
  applyTheme(); renderThemeBtn();
});

/* ================= NAV ================= */
const NAV = [
  { hash:'#/', label:'Home', icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10.5L12 3l9 7.5V21h-6v-6H9v6H3z"/></svg>' },
  { hash:'#/upload', label:'Create', icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V4m0 0l-4 4m4-4l4 4"/><path d="M4 20h16"/></svg>' },
  { hash:'#/mychannel', label:'My Channel', icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>' },
];
function currentHash(){ return location.hash || '#/'; }
function navActive(h){ return currentHash().split('?')[0] === h; }
function renderSidebar(){
  $('#sidebar').innerHTML = NAV.map(n=>`
    <a class="side-link ${navActive(n.hash)?'active':''}" href="${n.hash}">${n.icon}<span>${n.label}</span></a>`).join('') +
    `<div style="margin-top:auto;padding:12px 14px;font-size:12px;color:var(--text2)">KarmaWorkspace © ${new Date().getFullYear()}</div>`;
}
function renderBottomNav(){
  $('#bnav').innerHTML = NAV.map(n=>`
    <a class="bn ${navActive(n.hash)?'active':''}" href="${n.hash}">${n.icon}<span>${n.label}</span></a>`).join('');
}
function renderUserMenu(){
  const wrap = $('#userMenuWrap');
  if (!me){
    wrap.innerHTML = `<a class="btn sm" href="#/auth">Sign in</a>`;
    return;
  }
  wrap.innerHTML = `
    <button class="icon-btn" id="avatarBtn" title="Account">${avatarHTML(myProfile, 32)}</button>
    <div class="menu" id="userMenu">
      <a href="#/mychannel">My Channel</a>
      <a href="#/settings">Settings</a>
      <button class="mitem" id="logoutBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/></svg>Sign out
      </button>
    </div>`;
  $('#avatarBtn').onclick = e => { e.stopPropagation(); $('#userMenu').classList.toggle('open'); };
  document.addEventListener('click', ()=> $('#userMenu')?.classList.remove('open'));
  $('#logoutBtn').onclick = async () => { await sb.auth.signOut(); location.hash = '#/'; toast('Signed out'); };
}
function bindSearch(){
  $('#searchbar').addEventListener('submit', e=>{
    e.preventDefault();
    const q = $('#q').value.trim();
    if (q) location.hash = '#/search?q=' + encodeURIComponent(q);
  });
}

/* ================= ROUTER ================= */
async function route(){
  renderSidebar(); renderBottomNav(); renderUserMenu();
  window.scrollTo(0,0);
  const h = currentHash();
  const [path, qs] = h.slice(1).split('?');
  const params = new URLSearchParams(qs || '');
  const seg = path.split('/').filter(Boolean);

  if (!seg.length) return viewHome();
  switch(seg[0]){
    case 'post': return viewPost(params.get('id'));
    case 'channel': return viewChannel(params.get('id'));
    case 'mychannel': return me ? viewChannel(me.id) : viewAuth();
    case 'upload': return me ? viewUpload() : viewAuth();
    case 'settings': return me ? viewSettings() : viewAuth();
    case 'auth': return viewAuth();
    case 'search': return viewSearch(params.get('q') || '');
    default: return viewHome();
  }
}

/* ================= DATA QUERIES ================= */
const POST_SELECT = `id,owner,type,title,description,content,media_url,thumb_url,created_at,
  profiles!posts_owner_fkey(id,handle,name,avatar_url),
  likes(count), comments(count)`;

async function fetchPosts({ ownerId=null, search=null, limit=60 } = {}){
  let q = sb.from('posts').select(POST_SELECT).order('created_at', { ascending:false }).limit(limit);
  if (ownerId) q = q.eq('owner', ownerId);
  if (search) q = q.or(`title.ilike.%${search}%,description.ilike.%${search}%`);
  const { data, error } = await q;
  if (error) throw error;
  return data.map(p => ({ ...p, like_count: p.likes?.[0]?.count || 0, comment_count: p.comments?.[0]?.count || 0 }));
}
async function fetchMyLikes(postIds){
  if (!me || !postIds.length) return new Set();
  const { data } = await sb.from('likes').select('post_id').in('post_id', postIds).eq('user_id', me.id);
  return new Set((data||[]).map(l => l.post_id));
}

/* ================= VIEWS ================= */
function skeletonFeed(n=8){
  return `<div class="feed">${Array(n).fill(`<div><div class="skeleton" style="aspect-ratio:16/9"></div><div style="display:flex;gap:10px;margin-top:10px"><div class="skeleton" style="width:36px;height:36px;border-radius:50%"></div><div style="flex:1"><div class="skeleton" style="height:14px;margin-bottom:7px"></div><div class="skeleton" style="height:12px;width:65%"></div></div></div></div>`).join('')}</div>`;
}

async function viewHome(){
  main().innerHTML = `<div class="page-title">Latest on KarmaWorkspace</div>` + skeletonFeed();
  try{
    const posts = await fetchPosts();
    const liked = await fetchMyLikes(posts.map(p=>p.id));
    main().innerHTML = `<div class="page-title">Latest on KarmaWorkspace</div>` + (posts.length ? `<div class="feed">${posts.map(p=>cardHTML(p, liked.has(p.id))).join('')}</div>` : emptyState('Feed is empty', 'Be the first to share something!'));
  }catch(e){ main().innerHTML = errorState(e); }
}

function emptyState(title, sub){
  return `<div class="empty"><div class="big">🌱</div><b>${esc(title)}</b><br>${esc(sub)}
    ${me ? `<p style="margin-top:16px"><a class="btn" href="#/upload">Create a post</a></p>` : `<p style="margin-top:16px"><a class="btn" href="#/auth">Sign in to post</a></p>`}</div>`;
}
function errorState(e){
  return `<div class="empty"><div class="big">⚠️</div><b>Something went wrong</b><br>${esc(e?.message || 'Unknown error')}</div>`;
}

function cardHTML(p, isLiked){
  let thumb;
  if (p.type === 'video'){
    thumb = (p.thumb_url
      ? `<img src="${esc(p.thumb_url)}" alt="" loading="lazy">`
      : `<video src="${esc(p.media_url)}" preload="metadata" muted playsinline style="width:100%;height:100%;object-fit:cover"></video>`)
      + `<span class="badge">${ICONS.video} Video</span>`;
  } else if (p.type === 'image'){
    thumb = `<img src="${esc(p.media_url)}" alt="" loading="lazy"><span class="badge">${ICONS.image} Image</span>`;
  } else {
    thumb = `<div class="note-cover"><span>${esc((p.content||p.description||'').slice(0,140))}</span></div><span class="badge">${ICONS.note} Note</span>`;
  }
  return `
  <div class="card" onclick="location.hash='#/post?id=${p.id}'">
    <div class="thumb">${thumb}</div>
    <div class="card-meta">
      ${avatarHTML(p.profiles, 36)}
      <div style="min-width:0">
        <div class="card-title">${esc(p.title)}</div>
        <div class="card-sub">${esc(p.profiles?.name || 'Unknown')}<span class="dot">•</span>${timeAgo(p.created_at)}</div>
        <div class="card-sub" style="display:flex;gap:12px;margin-top:4px">
          <span>${isLiked ? ICONS.heart : ICONS.heartO} ${fmtNum(p.like_count)}</span>
          <span>${ICONS.comment} ${fmtNum(p.comment_count)}</span>
        </div>
      </div>
    </div>
  </div>`;
}

/* ---------- POST ---------- */
async function viewPost(id){
  if (!id) return viewHome();
